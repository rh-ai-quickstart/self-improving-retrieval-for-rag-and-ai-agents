# Copy to secrets.yaml beside this file, restrict permissions with `chmod 600`,
# and set any passwords you want to pin as Helm values.
#
#   cp secrets.yaml.example secrets.yaml
#
# This file is Helm values only. It is not Kubernetes Secret zenml-db-password.
# make bootstrap-server creates that Secret with oc before helm upgrade
# --install, from ZENML_DB_PASSWORD / ZENML_DB_ROOT_PASSWORD or generated
# values. Leave these fields empty unless you are installing the chart
# without the bootstrap script.

database:
  password: ""
  rootPassword: ""
