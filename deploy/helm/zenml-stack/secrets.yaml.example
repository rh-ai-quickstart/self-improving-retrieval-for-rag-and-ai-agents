# Copy to secrets.yaml beside this file, restrict permissions with `chmod 600`,
# and set any passwords you want to pin explicitly.
#
#   cp secrets.yaml.example secrets.yaml
#
# S4 S3 credentials and UI auth are required when s4.auth.enabled=true.
# Override the demo defaults from values.yaml here for non-demo installs.
#
# Registry pull credentials are normally refreshed post-install by
# `make refresh-stack-credentials`. Set registry values only when you want
# Helm to create the pull Secret during chart install.

s4:
  s3:
    accessKeyId: s4admin
    secretAccessKey: s4secret
  auth:
    username: admin
    password: changeme

registry:
  createPullSecret: false
  dockerServer: ""
  dockerPassword: ""
