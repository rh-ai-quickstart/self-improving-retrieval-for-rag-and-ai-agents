# Copy this file to deployment.env, restrict its permissions with `chmod 600`,
# and adjust the values for the target OpenShift environment.

# ZenML and OpenShift deployment
ZENML_NAMESPACE=zenml
# Leave empty to use the version installed in ZENML_PYTHON. Set an explicit
# version to pin both the Python client and Helm deployment. This POC was
# validated with 0.96.2; choose available releases from https://pypi.org/project/zenml/#history.
ZENML_VERSION=
ZENML_RELEASE=zenml-server
ZENML_SERVICE=zenml-server
ZENML_ROUTE=zenml-server

# Leave empty to let OpenShift assign the Route hostname.
ZENML_ROUTE_HOST=

# Persistent in-cluster MySQL database
ZENML_DB_SERVICE=zenml-mysql
ZENML_DB_NAME=zenml
ZENML_DB_USER=zenml
ZENML_DB_STORAGE=5Gi
ZENML_DB_MEMORY=1Gi
ZENML_DB_PASSWORD_SECRET=zenml-db-password

# On first deployment, leave these empty to generate random passwords.
# You can also set database.password and database.rootPassword in
# deploy/helm/zenml-server/secrets.yaml (copy secrets.yaml.example first).
# On subsequent runs, the database and existing Secrets are preserved.
ZENML_DB_PASSWORD=
ZENML_DB_ROOT_PASSWORD=

# Remote workload stack. Keep this project separate from ZENML_NAMESPACE.
ZENML_WORKLOAD_NAMESPACE=zenml-workloads
ZENML_ORCHESTRATOR_SA=zenml-orchestrator
ZENML_REGISTRY_PULL_SECRET=openshift-registry-route-pull

# ZenML registrations
ZENML_K8S_CONNECTOR=openshift-k8s
# Leave empty to derive the cluster name from the current oc context.
ZENML_K8S_CLUSTER_NAME=
ZENML_K8S_TOKEN_DURATION=24h
# ZenML treats the connector as expired this many seconds before its JWT expiry.
ZENML_CREDENTIAL_EXPIRY_SKEW_SECONDS=300
ZENML_ORCHESTRATOR=openshift-k8s
ZENML_ARTIFACT_STORE=openshift-minio
ZENML_ARTIFACT_SECRET=minio-artifact-store
ZENML_CONTAINER_REGISTRY=openshift-internal
ZENML_IMAGE_BUILDER=openshift-local
ZENML_EXPERIMENT_TRACKER=openshift-mlflow
ZENML_MLFLOW_TOKEN_DURATION=24h
ZENML_STACK=openshift
# delete-stack selects this before removing an active ZENML_STACK.
ZENML_DELETE_FALLBACK_STACK=default

# The Python executable must contain the selected ZenML version and Docker SDK.
# The stack bootstrap installs ZenML's S3 and MLflow integrations into it.
# The Python environment must be able to reach the local Docker daemon.
ZENML_PYTHON=python

# Persistent MinIO artifact store
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_SECRET_NAME=minio-root
MINIO_ROOT_USER=zenml-admin
# Leave empty to auto-generate on first install. You can also set
# minio.rootPassword in deploy/helm/zenml-stack/secrets.yaml.
MINIO_ROOT_PASSWORD=
MINIO_STORAGE_CLASS=gp3-csi
MINIO_STORAGE_SIZE=10Gi
MINIO_BUCKET=zenml-artifacts
MINIO_ROUTE_NAME=minio-s3

# Shared MLflow instance provided by Red Hat OpenShift AI. The instance is
# cluster-scoped and is preserved when the ZenML workload stack is deleted.
OPENSHIFT_AI_DSC=default-dsc
OPENSHIFT_AI_APPLICATIONS_NAMESPACE=redhat-ods-applications
MLFLOW_INSTANCE=mlflow
MLFLOW_STORAGE_CLASS=gp3-csi
MLFLOW_STORAGE_SIZE=10Gi
MLFLOW_INTEGRATION_CLUSTER_ROLE=mlflow-operator-mlflow-integration
MLFLOW_ROLE_BINDING=zenml-mlflow-integration

# OpenShift AI KServe deployment created by the retrieval pipeline.
MODEL_SERVING_NAME=retrieval-embedding
MODEL_SERVING_ROLE=zenml-kserve-deployer
MODEL_SERVING_ROLE_BINDING=zenml-kserve-deployer
MODEL_SERVING_TIMEOUT=600

# OpenShift integrated image registry
OPENSHIFT_REGISTRY_NAMESPACE=openshift-image-registry
OPENSHIFT_REGISTRY_ROUTE=default-route
OPENSHIFT_REGISTRY_USERNAME=openshift
ZENML_REGISTRY_TOKEN_DURATION=24h

# Non-interactive teardown requires this exact value. Keep empty normally.
ZENML_STACK_DELETE_CONFIRM=
